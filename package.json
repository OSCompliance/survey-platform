{
  "name": "survey-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "typecheck:api": "cd apps/api && tsc --noEmit",
    "typecheck:web": "cd apps/web && tsc --noEmit",
    "lint:web": "cd apps/web && eslint src",
    "build:web": "cd apps/web && vite build"
  }
}